# ==============================================================================
# HICHAT ENTERPRISE E2EE CHAT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In production on AWS ECS, these values are supplied via AWS Secrets Manager & ECS Task Definition.

# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment Mode ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (e.g. 3000, 8080)
PORT=3000

# Primary JWT Secret key for signing authentication tokens (min 32 characters)
# IMPORTANT: In production, generate a secure random 64-character secret!
JWT_SECRET=<YOUR_SECURE_RANDOM_64_CHAR_JWT_SECRET>

# ==============================================================================
# DATABASE CONFIGURATION (Amazon RDS PostgreSQL / Neon)
# ==============================================================================

# PostgreSQL Connection URL (e.g. postgresql://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# PostgreSQL Connection Pool Configuration
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# ==============================================================================
# DISTRIBUTED STATE & PUBSUB (Upstash Redis / Redis Cluster)
# ==============================================================================

# Redis Connection URL (e.g. rediss://<REDIS_USER>:<REDIS_TOKEN>@<REDIS_HOST>:6379)
REDIS_URL=rediss://<REDIS_USER>:<REDIS_TOKEN>@<REDIS_HOST>:6379

# ==============================================================================
# OPTIONAL ENVIRONMENT VARIABLES (Defaults provided if omitted)
# ==============================================================================

# Server Host Interface binding (Default: 0.0.0.0)
HOST=0.0.0.0

# Allowed CORS Origin(s) (e.g. https://chat.hichat.app)
CORS_ORIGIN=https://chat.hichat.app

# Trusted Reverse Proxy Support for AWS ALB / CloudFront (Default: true)
TRUST_PROXY=true

# JWT Token Expiration duration (Default: 15m)
JWT_EXPIRES_IN=15m

# Short-lived Access JWT Expiration duration (Default: 15m)
JWT_ACCESS_EXPIRES_IN=15m

# Long-lived Refresh Token Expiration duration (Default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global Rate Limiting - Max requests per IP within the window (Default: 100)
RATE_LIMIT_MAX=100

# Rate Limiting Window duration in milliseconds (Default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Mailbox retry sweep interval in milliseconds for unacknowledged DMs (Default: 5000)
MAILBOX_RETRY_INTERVAL_MS=5000

# Maximum delivery attempts for unacknowledged mailbox DMs (Default: 5)
MAILBOX_MAX_RETRIES=5

# Comma-separated backoff delays in milliseconds for retry attempts (Default: 0,5000,15000,30000,60000)
MAILBOX_RETRY_DELAYS=0,5000,15000,30000,60000
